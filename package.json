{
  "name": "lab3",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "format": "prettier --write --experimental-cli src/",
    "dev:server": "node server/index.cjs",
    "storybook": "set STORYBOOK=1 && storybook dev -p 6006",
    "build-storybook": "set STORYBOOK=1 && storybook build",
    "docs": "jsdoc -c jsdoc.config.json",
    "license-check": "license-checker --csv --out license-report.txt"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "vue": "^3.5.25",
    "vue-router": "^4.6.3"
  },
  "devDependencies": {
    "@storybook/addon-essentials": "^8.6.14",
    "@storybook/blocks": "^8.6.14",
    "@storybook/vue3": "^8.6.17",
    "@storybook/vue3-vite": "^8.6.17",
    "@tailwindcss/postcss": "^4.1.18",
    "@tsconfig/node24": "^24.0.3",
    "@types/node": "^24.10.1",
    "@vitejs/plugin-vue": "^6.0.2",
    "@vue/tsconfig": "^0.8.1",
    "autoprefixer": "^10.4.23",
    "jsdoc": "^4.0.5",
    "license-checker": "^25.0.1",
    "npm-run-all2": "^8.0.4",
    "postcss": "^8.5.6",
    "prettier": "3.6.2",
    "storybook": "^8.6.17",
    "tailwindcss": "^4.1.18",
    "typescript": "~5.9.0",
    "vite": "^7.2.4",
    "vite-plugin-vue-devtools": "^8.0.5",
    "vue-tsc": "^3.1.5"
  }
}
